# 서버 설정
PORT=3000
HOST=0.0.0.0

# JWT 시크릿 (32자 이상 랜덤 문자열)
JWT_SECRET=your-super-secret-jwt-key-change-this

# PostgreSQL 연결 (Supabase 또는 일반 PG)
DATABASE_URL=postgresql://user:password@host:5432/link26

# CORS 허용 출처 (Flutter Web 배포 URL)
ALLOWED_ORIGINS=http://localhost:8080,https://your-app.vercel.app
